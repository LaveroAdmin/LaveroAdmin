{
    "name": "laveroadmin/laveroadmin",
    "description": "LaveroAdmin. Open-source Laravel Admin panel.",
    "type": "library",
    "keywords": [
        "laravel",
        "admin",
        "grid",
        "form",
        "laveroadmin",
        "lavero-admin",
        "open",
        "free"
    ],
    "homepage": "https://bespredel.name",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name",
            "homepage": "https://bespredel.name"
        }
    ],
    "require": {
        "php": ">=7.3",
        "symfony/dom-crawler": "^4.0|^5.0|^6.0|^7.0|^8.0",
        "laravel/framework": "^7.0|^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "doctrine/dbal": "^2.6|^3.0|^4.0"
    },
    "require-dev": {
        "laravel/laravel": ">=8.0",
        "fakerphp/faker": "^1.9.1",
        "intervention/image": "^4.0",
        "laravel/browser-kit-testing": "^6.0|^7.0",
        "spatie/phpunit-watcher": "^1.22.0"
    },
    "autoload": {
        "psr-4": {
            "LaveroAdmin\\Admin\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Models\\": "tests/models",
            "Tests\\Controllers\\": "tests/controllers"
        },
        "classmap": [
            "tests/TestCase.php"
        ]
    },
    "scripts": {
        "sass": "sass --watch resources/assets/lavero-admin/scss/styles.scss:resources/assets/lavero-admin/css/styles.css resources/assets/lavero-admin/scss/pages:resources/assets/lavero-admin/css/pages --style compressed",
        "test": "./vendor/bin/phpunit"
    },
    "suggest": {
        "intervention/image": "Required to handle and manipulate upload images (^4.0).",
        "spatie/eloquent-sortable": "Required to build orderable grid.",
        "phpoffice/phpspreadsheet": "Required to export grid data to Excel (.xlsx) format."
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaveroAdmin\\Admin\\AdminServiceProvider"
            ],
            "aliases": {
                "Admin": "LaveroAdmin\\Admin\\Facades\\Admin"
            }
        }
    },
    "config": {
        "process-timeout": 0
    }
}
