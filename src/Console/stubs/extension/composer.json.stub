{
    "name": ":package",
    "description": "description...",
    "type": "library",
    "keywords": ["lavero-admin", "extension"],
    "homepage": "https://github.com/:package",
    "license": "MIT",
    "authors": [
        {
            "name": "Aleksandr Kireev",
            "email": "hello@bespredel.name",
            "homepage": "https://bespredel.name"
        }
    ],
    "require": {
        "php": ">=8.1.0",
        "laveroadmin/laveroadmin": "^1.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.0 || ^10.0"
    },
    "autoload": {
        "psr-4": {
            ":namespace": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                ":namespace:class_nameServiceProvider"
            ]
        }
    }
}
