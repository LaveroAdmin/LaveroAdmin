parameters:
    level: 5
    paths:
        - src
    excludePaths:
        - src/Console/stubs/*
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false
    treatPhpDocTypesAsCertain: false
    ignoreErrors:
        - '#Unsafe usage of new static\(\)#'
        - '#Call to an undefined method [a-zA-Z0-9\\_]+::#'
